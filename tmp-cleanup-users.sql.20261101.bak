SET NAMES utf8mb4;

USE `rangiffler-auth`;
DELETE FROM `authority`
WHERE user_id IN (
  SELECT id FROM `user` WHERE username NOT IN ('duck', 'люся')
);
DELETE FROM `user` WHERE username NOT IN ('duck', 'люся');

USE `rangiffler-api`;
DELETE FROM `friendship`
WHERE requester_id IN (SELECT id FROM `user` WHERE username NOT IN ('duck', 'люся'))
   OR addressee_id IN (SELECT id FROM `user` WHERE username NOT IN ('duck', 'люся'));
DELETE FROM `photo_like`
WHERE photo_id IN (
  SELECT p.id FROM `photo` p
  INNER JOIN `user` u ON u.id = p.user_id
  WHERE u.username NOT IN ('duck', 'люся')
)
OR like_id IN (
  SELECT l.id FROM `like` l
  INNER JOIN `user` u ON u.id = l.user_id
  WHERE u.username NOT IN ('duck', 'люся')
);
DELETE FROM `like`
WHERE user_id IN (SELECT id FROM `user` WHERE username NOT IN ('duck', 'люся'));
DELETE FROM `photo`
WHERE user_id IN (SELECT id FROM `user` WHERE username NOT IN ('duck', 'люся'));
DELETE FROM `statistic`
WHERE user_id IN (SELECT id FROM `user` WHERE username NOT IN ('duck', 'люся'));
DELETE FROM `user` WHERE username NOT IN ('duck', 'люся');

SELECT 'auth' AS db, username FROM `rangiffler-auth`.`user`;
SELECT 'api' AS db, username FROM `rangiffler-api`.`user`;
